# ============================================================
# AUTHENTIC J.A. CONSTRUCTION LTD. — environment template
# Copy to .env (root or per-app) and fill in real values.
# NEVER commit real secrets. Keep this file as the source of
# truth for which variables exist.
# ============================================================

# --- Database -------------------------------------------------
# PostgreSQL connection string (packages/database, services/api)
DATABASE_URL=postgresql://ajac:ajac_dev_password@localhost:5432/ajac?schema=public

# --- Authentication & security --------------------------------
# At least 32 random bytes, base64 or hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# JWT lifetimes (seconds)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Bootstrap admin created by `npm run seed --workspace=@ajac/api`.
# Leave SEED_ADMIN_PASSWORD empty in development for a generated one-time password.
SEED_ADMIN_EMAIL=admin@authenticja.com
SEED_ADMIN_PASSWORD=
# Comma-separated list of origin(s) allowed to call the API
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Services / API -------------------------------------------
PORT=4000
# Public base URL of the API (used for signed URLs, links in emails)
API_PUBLIC_URL=http://localhost:4000
# Public base URL of the web app (used for email links, deep links)
APP_PUBLIC_URL=http://localhost:3000

# --- Object storage -------------------------------------------
# Providers: local | aws-s3 | cloudflare-r2 | google-gcs
STORAGE_PROVIDER=local
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
# Public CDN base URL if a public CDN fronts the bucket
STORAGE_PUBLIC_URL=

# --- Email ----------------------------------------------------
# Providers: resend | sendgrid | smtp
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AUTHENTIC J.A. CONSTRUCTION LTD. <no-reply@example.com>"

# --- Push notifications ---------------------------------------
# Expo Push API token (EAS project) or FCM server key
PUSH_NOTIFICATION_CONFIG=

# --- Payments / mobile money ----------------------------------
# Provider tokens are stored in the database by admins; these vars
# hold provider API credentials when a payment gateway is wired.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=

# --- Maps -----------------------------------------------------
MAPS_API_KEY=

# --- Feature flags --------------------------------------------
# Set to "true" to enable development-only behaviors (seed routes, etc.)
ENABLE_DEV_SEEDS=false
