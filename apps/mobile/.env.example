# AUTHENTIC J.A. mobile app — environment variables.
# Copy to `.env` and adjust for your self-hosted setup. Variables are inlined
# at build time by Expo (must start with EXPO_PUBLIC_ to reach the client).

# Base URL of the self-hosted NestJS API. Defaults to the local dev API.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# On a physical device the emulator localhost won't work — point at your
# machine's LAN IP instead, e.g. http://192.168.1.50:4000/api/v1
