// AUTHENTIC J.A. CONSTRUCTION LTD. — relational schema (Phase 3).
// PostgreSQL 16 via Prisma. Conventions applied to every model:
//   - String @id @default(uuid()) primary key
//   - createdAt DateTime @default(now()) + updatedAt DateTime @updatedAt
//   - Soft delete via `deletedAt DateTime?` where appropriate
//   - FKs + indexes on all relations and common lookup columns
//   - unique constraints on business keys (email, codes, references)
//   - Decimal for money (18,2) and quantities (14,3); Json for flexible payloads
//   - Passwords stored ONLY as scrypt hashes (see packages/auth) — never plaintext

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

