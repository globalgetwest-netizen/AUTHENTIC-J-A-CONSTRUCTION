{
  "name": "@ajac/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and database client for the AUTHENTIC J.A. ecosystem.",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-generated.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "^6.19.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^6.19.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
