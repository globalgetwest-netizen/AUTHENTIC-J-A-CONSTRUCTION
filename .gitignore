# Dependencies
node_modules/
.pnp
.pnp.js

# Turbo build cache
.turbo/

# Build outputs
dist/
build/
.next/
out/
export/
.expo/
.expo-shared/
coverage/
*.tsbuildinfo
apps/web/.next/
apps/mobile/dist/
services/api/dist/

# Environment & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Native / platform
*.apk
*.aab
*.ipa
ios/
android/
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# Logs
logs/
*.log

# Local machine-specific tooling & runtime artifacts (session logs, offline
# PDF build scripts that hardcode local paths). Never commit these.
.local/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Prisma (engines are fetched, not committed; client regenerated via prisma generate)
packages/database/node_modules/
packages/database/src/generated/

# Self-hosted document uploads (runtime files — never commit user content)
services/api/uploads/

# PDF test renders
apps/web/.pdfcheck/
apps/web/.cert-preview/

# Browser test artifacts — auth cookies, never commit
apps/web/*.txt

# Local-only helper scripts (hardcode local paths / machine state)
.ver-audit.sh
apps/web/public/brand/extract_assets.py
apps/web/public/brand/extract_sig.py
